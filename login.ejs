<%- include('layout/header') %>

<div class="min-h-screen flex items-center justify-center -mt-8">
    <div class="clay p-8 w-full max-w-md">
        <div class="text-center mb-8">
            <div class="flex justify-center mb-3">
                <div class="bg-indigo-100 p-4 rounded-2xl border-2 border-indigo-300" style="box-shadow:4px 4px 0 #4338ca">
                    <i data-lucide="calendar-check" class="w-10 h-10 text-indigo-600"></i>
                </div>
            </div>
            <h1 class="text-3xl font-black text-gray-900">AttendEase</h1>
            <p class="text-gray-500 mt-1">Sign in to your account</p>
        </div>

        <form action="/login" method="POST" class="flex flex-col gap-5">
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Email</label>
                <input type="email" name="email" placeholder="you@school.edu"
                    class="input-clay" required autofocus>
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Password</label>
                <input type="password" name="password" placeholder="••••••••"
                    class="input-clay" required>
            </div>
            <button type="submit" class="btn-clay btn-primary w-full justify-center py-3 text-base mt-2">
                Sign In →
            </button>
        </form>

        <p class="text-center text-sm text-gray-500 mt-6">
            No account? <a href="/register" class="text-indigo-600 font-bold hover:underline">Register here</a>
        </p>



    </div>
</div>

<%- include('layout/footer') %>
