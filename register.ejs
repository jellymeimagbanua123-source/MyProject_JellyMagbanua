<%- include('layout/header') %>

<div class="min-h-screen flex items-center justify-center -mt-8">
    <div class="clay p-8 w-full max-w-md">
        <div class="text-center mb-8">
            <div class="flex justify-center mb-3">
                <div class="bg-green-100 p-4 rounded-2xl border-2 border-green-300" style="box-shadow:4px 4px 0 #15803d">
                    <i data-lucide="user-plus" class="w-10 h-10 text-green-600"></i>
                </div>
            </div>
            <h1 class="text-2xl font-black text-gray-900">Create Account</h1>
            <p class="text-gray-500 mt-1">Register as a teacher</p>
        </div>

        <form action="/register" method="POST" class="flex flex-col gap-4">
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Full Name</label>
                <input type="text" name="name" placeholder="Your full name"
                    class="input-clay" required>
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Email</label>
                <input type="email" name="email" placeholder="you@school.edu"
                    class="input-clay" required>
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Password</label>
                <input type="password" name="password" placeholder="Min. 6 characters"
                    class="input-clay" required minlength="6">
            </div>
            <div>
                <label class="block text-sm font-bold text-gray-700 mb-1">Role</label>
                <select name="role" class="input-clay">
                    <option value="teacher">Teacher</option>
                </select>
            </div>
            <button type="submit" class="btn-clay btn-success w-full justify-center py-3 text-base mt-2">
                Create Account →
            </button>
        </form>

        <p class="text-center text-sm text-gray-500 mt-6">
            Already have an account? <a href="/login" class="text-indigo-600 font-bold hover:underline">Sign in</a>
        </p>
    </div>
</div>

<%- include('layout/footer') %>
