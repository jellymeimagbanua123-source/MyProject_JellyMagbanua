{
    "version": 2,
    "builds": [
        { "src": "public/index.html", "use": "@vercel/static" },
        { "src": "api/anime.js",      "use": "@vercel/node"   }
    ],
    "routes": [
        { "src": "/api/anime",  "dest": "/api/anime.js" },
        { "src": "/(.*)",       "dest": "/public/index.html" }
    ]
}
