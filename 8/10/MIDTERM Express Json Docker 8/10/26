<body>
<div class="container">

    <h1>🎓 Student Database</h1>
    <p class="subtitle">Powered by Express + JSON + Docker</p>

    <!-- STATS -->
    <div class="stats">
        <div class="stat">
            <div class="num" id="statTotal">0</div>
            <div class="lbl">Total</div>
        </div>
        <div class="stat">
            <div class="num" id="statActive">0</div>
            <div class="lbl">Active</div>
        </div>
        <div class="stat">
            <div class="num" id="statGrad">0</div>
            <div class="lbl">Graduated</div>
        </div>
        <div class="stat">
            <div class="num" id="statAvgGpa">0.00</div>
            <div class="lbl">Avg GPA</div>
        </div>
    </div>

    <!-- ADD FORM -->
    <div class="form-box">
        <h2>+ Add New Student</h2>
        <div class="form-row">
            <input type="text"   id="inName"   placeholder="Full Name" required>
            <input type="text"   id="inCourse" placeholder="Course (e.g. BSIT)">
            <input type="number" id="inYear"   placeholder="Year" min="1" max="5">
            <input type="number" id="inGpa"    placeholder="GPA" step="0.01" min="1" max="5">
            <select id="inStatus">
                <option value="Active">Active</option>
                <option value="Graduated">Graduated</option>
            </select>
            <button class="btn-add" onclick="addStudent()">Add</button>
        </div>
    </div>

    <!-- TABLE -->
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>Course</th>
                    <th>Year</th>
                    <th>GPA</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                <tr class="empty-row"><td colspan="7">Loading...</td></tr>
            </tbody>
        </table>
    </div>

</div>

<div id="toast"></div>

<script>
    // ── Load all students ──────────────────────────────────
    function loadStudents() {
        fetch('/api/students')
            .then(function(res) { return res.json(); })
            .then(function(data) {
                renderTable(data);
                updateStats(data);
            });
    }

    // ── Render table ───────────────────────────────────────
    function renderTable(data) {
        var tbody = document.getElementById('tableBody');

        if (data.length === 0) {
            tbody.innerHTML = '<tr class="empty-row"><td colspan="7">No students found.</td></tr>';
            return;
        }

        tbody.innerHTML = data.map(function(s) {
            var badgeClass = s.status === 'Graduated' ? 'badge-graduated' : 'badge-active';
            return '<tr>' +
                '<td>' + s.id + '</td>' +
                '<td>' + s.name + '</td>' +
                '<td>' + s.course + '</td>' +
                '<td>Year ' + s.year + '</td>' +
                '<td class="gpa">' + s.gpa.toFixed(2) + '</td>' +
                '<td><span class="badge ' + badgeClass + '">' + s.status + '</span></td>' +
                '<td><button class="btn-del" onclick="deleteStudent(' + s.id + ')">🗑 Delete</button></td>' +
            '</tr>';
        }).join('');
    }

    // ── Update stats ───────────────────────────────────────
    function updateStats(data) {
        var active = data.filter(function(s) { return s.status === 'Active'; }).length;
        var grad   = data.filter(function(s) { return s.status === 'Graduated'; }).length;
        var avgGpa = data.length > 0
            ? (data.reduce(function(sum, s) { return sum + s.gpa; }, 0) / data.length).toFixed(2)
            : '0.00';

        document.getElementById('statTotal').textContent  = data.length;
        document.getElementById('statActive').textContent = active;
        document.getElementById('statGrad').textContent   = grad;
        document.getElementById('statAvgGpa').textContent = avgGpa;
    }

    // ── Add student ────────────────────────────────────────
    function addStudent() {
        var name   = document.getElementById('inName').value.trim();
        var course = document.getElementById('inCourse').value.trim();
        var year   = document.getElementById('inYear').value;
        var gpa    = document.getElementById('inGpa').value;
        var status = document.getElementById('inStatus').value;

        if (!name || !course) {
            showToast('Name and Course are required!', '#ef4444');
            return;
        }

        fetch('/api/students', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ name: name, course: course, year: year, gpa: gpa, status: status })
        })
        .then(function(res) { return res.json(); })
        .then(function() {
            document.getElementById('inName').value   = '';
            document.getElementById('inCourse').value = '';
            document.getElementById('inYear').value   = '';
            document.getElementById('inGpa').value    = '';
            loadStudents();
            showToast('Student added!', '#22c55e');
        });
    }

    // ── Delete student ─────────────────────────────────────
    function deleteStudent(id) {
        if (!confirm('Delete this student?')) return;

        fetch('/api/students/' + id, { method: 'DELETE' })
            .then(function(res) { return res.json(); })
            .then(function() {
                loadStudents();
                showToast('Student deleted!', '#f87171');
            });
    }

    // ── Toast notification ─────────────────────────────────
    function showToast(msg, color) {
        var toast = document.getElementById('toast');
        toast.textContent       = msg;
        toast.style.background  = color;
        toast.style.display     = 'block';
        setTimeout(function() { toast.style.display = 'none'; }, 2500);
    }

    // ── Init ───────────────────────────────────────────────
    loadStudents();
</script>
</body>
</html>

