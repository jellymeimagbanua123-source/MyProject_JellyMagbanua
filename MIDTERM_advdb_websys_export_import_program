cafe.js

const MENU = {
    espresso:   { price: 60,  category: 'coffee' },
    latte:      { price: 90,  category: 'coffee' },
    mocha:      { price: 95,  category: 'coffee' },
    matcha:     { price: 100, category: 'tea'    },
    sandwich:   { price: 120, category: 'food'   },
    croissant:  { price: 85,  category: 'food'   },
};

function showMenu() {
    console.log('\n===== CAFE MENU =====');
    for (var item in MENU) {
        console.log('  ' + item + ' ............. ₱' + MENU[item].price);
    }
    console.log('=====================\n');
}

function getPrice(item) {
    if (!MENU[item]) {
        return 0;
    }
    return MENU[item].price;
}

// order = [{ item: 'latte', qty: 2 }, { item: 'croissant', qty: 1 }]
function computeSubtotal(order) {
    var subtotal = 0;
    order.forEach(function(o) {
        subtotal += getPrice(o.item) * o.qty;
    });
    return subtotal;
}

// 10% discount if subtotal >= 300
function applyDiscount(subtotal) {
    if (subtotal >= 300) {
        var discount = subtotal * 0.10;
        return {
            discount:    discount,
            totalAfter:  subtotal - discount,
            hasDiscount: true
        };
    }
    return {
        discount:    0,
        totalAfter:  subtotal,
        hasDiscount: false
    };
}

function printReceipt(customerName, order) {
    var subtotal = computeSubtotal(order);
    var result   = applyDiscount(subtotal);

    console.log('\n========== RECEIPT ==========');
    console.log('Customer : ' + customerName);
    console.log('-----------------------------');
    order.forEach(function(o) {
        var lineTotal = getPrice(o.item) * o.qty;
        console.log('  ' + o.item + ' x' + o.qty + ' = ₱' + lineTotal);
    });
    console.log('-----------------------------');
    console.log('Subtotal : ₱' + subtotal);
    if (result.hasDiscount) {
        console.log('Discount : -₱' + result.discount + ' (10% off!)');
    }
    console.log('TOTAL    : ₱' + result.totalAfter);
    console.log('=============================\n');
}
module.exports = {
    showMenu,
    getPrice,
    computeSubtotal,
    applyDiscount,
    printReceipt
};
