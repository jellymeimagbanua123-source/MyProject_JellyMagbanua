<%- include('layout/header') %>

<div class="mb-6">
    <h1 class="text-3xl font-black text-gray-900">Dashboard</h1>
    <p class="text-gray-500 mt-1">Today: <%= today %></p>
</div>

<!-- Stat Cards -->
<div class="grid grid-cols-2 md:grid-cols-4 gap-5 mb-8">
    <div class="clay clay-blue p-5 text-center">
        <div class="flex justify-center mb-2"><i data-lucide="users" class="w-8 h-8 text-blue-600"></i></div>
        <div class="text-4xl font-black text-blue-700"><%= totalStudents %></div>
        <div class="text-sm font-bold text-blue-600 mt-1">Total Students</div>
    </div>
    <div class="clay clay-green p-5 text-center">
        <div class="flex justify-center mb-2"><i data-lucide="user-check" class="w-8 h-8 text-green-600"></i></div>
        <div class="text-4xl font-black text-green-700"><%= presentToday %></div>
        <div class="text-sm font-bold text-green-600 mt-1">Present Today</div>
    </div>
    <div class="clay clay-red p-5 text-center">
        <div class="flex justify-center mb-2"><i data-lucide="user-x" class="w-8 h-8 text-red-600"></i></div>
        <div class="text-4xl font-black text-red-700"><%= absentToday %></div>
        <div class="text-sm font-bold text-red-600 mt-1">Absent Today</div>
    </div>
    <div class="clay clay-yellow p-5 text-center">
        <div class="flex justify-center mb-2"><i data-lucide="clock" class="w-8 h-8 text-yellow-600"></i></div>
        <div class="text-4xl font-black text-yellow-700"><%= lateToday %></div>
        <div class="text-sm font-bold text-yellow-600 mt-1">Late Today</div>
    </div>
</div>

<!-- Quick Actions -->
<div class="flex flex-wrap gap-3 mb-8">
    <a href="/attendance/mark"   class="btn-clay btn-primary flex items-center gap-2"><i data-lucide="clipboard-pen" class="w-4 h-4"></i> Mark Attendance</a>
    <a href="/students/add"      class="btn-clay btn-success flex items-center gap-2"><i data-lucide="user-plus"    class="w-4 h-4"></i> Add Student</a>
    <a href="/attendance/report" class="btn-clay btn-warning flex items-center gap-2"><i data-lucide="bar-chart-2"  class="w-4 h-4"></i> View Report</a>
    <a href="/students"          class="btn-clay btn-ghost   flex items-center gap-2"><i data-lucide="users"        class="w-4 h-4"></i> All Students</a>
</div>

<!-- Recent Attendance -->
<div class="clay p-6">
    <h2 class="text-lg font-black text-gray-800 mb-4">Recent Attendance</h2>
    <% if (recentAttendance.length === 0) { %>
        <p class="text-gray-400 text-center py-8">No attendance records yet. <a href="/attendance/mark" class="text-indigo-600 font-bold">Mark attendance →</a></p>
    <% } else { %>
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="border-b-2 border-gray-200">
                    <th class="text-left py-2 px-3 font-bold text-gray-600">Student</th>
                    <th class="text-left py-2 px-3 font-bold text-gray-600">Subject</th>
                    <th class="text-left py-2 px-3 font-bold text-gray-600">Date</th>
                    <th class="text-left py-2 px-3 font-bold text-gray-600">Status</th>
                    <th class="text-left py-2 px-3 font-bold text-gray-600">Marked By</th>
                </tr>
            </thead>
            <tbody>
                <% recentAttendance.forEach(a => { %>
                <tr class="border-b border-gray-100 hover:bg-gray-50">
                    <td class="py-2 px-3 font-semibold"><%= a.student ? a.student.firstName + ' ' + a.student.lastName : 'N/A' %></td>
                    <td class="py-2 px-3 text-gray-600"><%= a.subject %></td>
                    <td class="py-2 px-3 text-gray-500"><%= new Date(a.date).toLocaleDateString() %></td>
                    <td class="py-2 px-3"><span class="badge badge-<%= a.status %>"><%= a.status %></span></td>
                    <td class="py-2 px-3 text-gray-500"><%= a.markedBy ? a.markedBy.name : '—' %></td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
    <% } %>
</div>

<%- include('layout/footer') %>
